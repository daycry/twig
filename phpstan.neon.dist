parameters:
    tmpDir: build/phpstan
    level: 5
    paths:
        - src/
        - tests/
    bootstrapFiles:
        - tests/bootstrap.php
    excludePaths:
        - tests/Consumers/*/vendor/*
        - tests/Consumers/*/writable/*
    universalObjectCratesClasses:
        - CodeIgniter\Entity\Entity
        - Faker\Generator
    scanDirectories:
        - vendor/codeigniter4/framework/system/Helpers
    dynamicConstantNames:
        - APP_NAMESPACE
        - CI_DEBUG
        - ENVIRONMENT
