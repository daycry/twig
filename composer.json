{
    "name": "daycry/twig",
    "description": "Standalone Twig toolkit with an optional CodeIgniter 4 adapter",
    "keywords": [
        "codeigniter",
        "twig",
        "templates",
        "codeigniter4",
        "html"
    ],
    "homepage": "https://github.com/daycry/twig",
    "authors": [
        {
            "name": "daycry",
            "homepage": "https://github.com/daycry",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.30",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "codeigniter4/devkit": "^1.3",
        "codeigniter4/framework": "^4.7",
        "rector/rector": "^2",
        "deptrac/deptrac": "^4.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Daycry\\Twig\\": "src/",
            "Daycry\\Twig\\CodeIgniter4\\": "src/Adapter/CodeIgniter4/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Support\\": "tests/_support"
        },
        "files": [
            "tests/_support/Functions/twigFunctions.php"
        ]
    },
    "scripts": {
        "analyze": [
            "phpstan analyze"
        ],
        "sa": "@analyze",
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "@cs",
            "@deduplicate",
            "@analyze",
            "@test",
            "@architecture"
        ],
        "cs": [
            "Composer\\Config::disableProcessTimeout",
            "php-cs-fixer fix --ansi --verbose --dry-run --diff"
        ],
        "cs-fix": [
            "Composer\\Config::disableProcessTimeout",
            "php-cs-fixer fix --ansi --verbose --diff"
        ],
        "style": "@cs-fix",
        "deduplicate": "php phpcpd.phar src/",
        "mutate": "infection --threads=2 --skip-initial-tests --coverage=build/phpunit",
        "test": [
            "@test:standalone",
            "@test:codeigniter"
        ],
        "test:standalone": "phpunit -c phpunit.standalone.xml.dist --no-coverage",
        "architecture": "deptrac analyse --cache-file=build/deptrac.cache --no-progress",
        "test:codeigniter": "phpunit --no-coverage"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "suggest": {
        "codeigniter4/framework": "Optional framework integration through the included CodeIgniter 4 adapter (^4.7)"
    },
    "archive": {
        "exclude": [
            "/vendor/",
            "/composer.lock",
            "/build/",
            "/tests/",
            "/.github/",
            "/.claude/",
            "/.codex/",
            "/.vscode/"
        ]
    }
}
